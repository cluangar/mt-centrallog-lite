# mt-centrallog LITE — environment file
#
# Two-directory workflow: this template lives in the BUILD dir; `./deploy.sh`
# seeds it into the RUN dir's .env on first run, then stops so you can edit it.
# Fill in your values, then re-run `./release.sh` (build + deploy).
#
# Lite is SQLite-only with no AI / SNMP / MCP / MariaDB / ramdisk. Those
# full-only capabilities are gated by env flags that DEFAULT OFF in the code,
# so you can leave them out entirely — Lite and Full share the same .env format,
# which is what makes the in-place Lite→Full upgrade a drop-in (same /data +
# same .env, swap the images).

# ── Timezone ───────────────────────────────────────────────────────────────
TZ=Asia/Bangkok

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=mt-centrallog-lite
# Container-name prefix for Service Status + restore auto-restart. The backend
# AUTO-DETECTS this from its own Compose project at runtime, so you normally don't
# need it. Kept here only as a fallback; if set, match `name:` in docker-compose.yml.
SERVICE_PREFIX=mt-centrallog-lite
# Lite runs the SAME version number as Full: keep MAJOR/MINOR matched to the Full
# release, and changelog.js is shared (mirrored) so PATCH is identical too.
APP_VERSION_MAJOR=1
APP_VERSION_MINOR=5
APP_VERSION_STAGE=dev                       # dev → beta → rc → main
TEST_ALERT_BUTTON_ENABLED=false

# Web server published ports (browser side). Container always listens on 80/443.
SSL_ENABLED=true
# The :443 certificate has to name the address you type. iOS and Android refuse a
# cert with no matching subjectAltName and offer NO bypass. Example for a fixed
# site address: TLS_SAN=IP:192.168.1.83,DNS:localhost — on a box whose IP changes,
# update this line (only the leaf is re-issued; the site CA never changes).
TLS_SAN=IP:127.0.0.1,DNS:localhost
# Certificate lifetimes (days). The CA is re-minted only if missing; leaf re-issue
# on age/SAN change never requires devices to re-trust anything.
TLS_CA_DAYS=3650                      # site CA validity
TLS_LEAF_DAYS=800                     # served leaf — 800 keeps it under Apple's 825-day server-cert cap
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ── Frontend base URL (optional) ───────────────────────────────────────────
# Base URL of the frontend, used to build absolute links in emails (e.g. the
# 2FA lost-authenticator recovery link). OPTIONAL:
#   • Leave BLANK (default) → auto-detected from the request. The link is built
#     from the Host + scheme the user actually used to reach the app
#     (X-Forwarded-Proto + Host, forwarded by the project's nginx), so it always
#     points at the right host with no config and follows the IP/hostname if it
#     changes.
#   • Set it (e.g. FRONTEND_BASE_URL=https://mt.example.com) → always use this
#     exact URL. Use it when the backend is NOT behind the project's nginx proxy,
#     or the public hostname differs from the request Host header.
FRONTEND_BASE_URL=

# ── JWT — REQUIRED, strong random string ≥ 32 chars ─────────────────────────
# The backend REFUSES TO START if this is the placeholder or too short.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_generate_a_32_char_random_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SSH host-key pinning (MikroTik SSH for .backup restore) ─────────────────
# Learn-and-verify. Leave false until every device has been contacted once,
# then flip true to enforce and refuse a changed key (MITM protection).
SSH_HOST_KEY_ENFORCE=false

# ── Database (SQLite only in Lite) ──────────────────────────────────────────
DB_TYPE=sqlite
SQLITE_PATH=/data/centrallog.db
RAMDISK_ENABLED=false                       # Lite does not support ramdisk
DB_AUTOHEAL_ENABLED=false                   # boot-time auto-heal — WORKS on Lite too; set true (esp. on unreliable storage) to promote the newest clean backup on a corrupt/empty DB at startup
DB_AUTOHEAL_MIN_ROWS_TABLE=users              # table that must hold >=1 row for the DB to count as "non-empty"
DB_BACKUP_INTERVAL_HOURS=4                  # backend writes centrallog.db.bak (0 = off)
DB_BACKUP_KEEP=10                           # DB Admin backups kept on server
RESTORE_AUTO_RESTART=true                   # auto-restart backend+poller after a DB restore

# Host DB watchdog (db_watchdog.sh, cron */10 — installed by install.sh/update.sh, NOT a container).
# Read from this .env. Detects live DB corruption (read-only integrity_check + backend malformed-log
# signal) and auto-recovers by stop-both-writers → heal-backend → start-poller.
# Intended for UNRELIABLE storage (SD card / eMMC / USB) — on SSD/NVMe it is unnecessary overhead
# (hourly ~130MB snapshots) and auto-recovery essentially never fires, so it ships OFF.
DB_WATCHDOG_ENABLED=false                   # set true ONLY on unreliable disk (SD/eMMC/USB)
DB_WATCHDOG_AUTORECOVER=true                # auto stop+heal+start on confirmed corruption (false = detect + snapshot + forensics only)
#DB_WATCHDOG_ERR_THRESHOLD=3                # backend malformed errors in the window that count as live-path corruption
#DB_WATCHDOG_ERR_WINDOW_MIN=12           # how many MINUTES of backend log that count covers (plain wall-clock `docker logs --since`, not since the container started)
#DB_WATCHDOG_COOLDOWN_SEC=900               # min seconds between auto-recovery attempts
#DB_WATCHDOG_MAX_FAILS=3                     # consecutive failed recoveries before it escalates and stops auto-recovering
#DB_WATCHDOG_LOG_LINES=1000                  # watchdog.log is trimmed to this many newest lines each run (runs forever via cron)
#DB_WATCHDOG_EVENTS_LINES=5000                # .watchdog/events.tsv keeps this many newest rows; read it with `./db_watchdog.sh events <run-dir>`
#DB_WATCHDOG_EVENTS_LEVEL=critical         # critical = only flagged runs write a row (default; keeps the record tiny on an SD card). all = one row per run, read it with `./db_watchdog.sh events <run-dir>`
#DB_WATCHDOG_SNAPSHOT_MIN_BYTES=10000000   # a watchdog snapshot smaller than this is thrown away and recorded as rejected — an empty file still passes the integrity check
#DB_WATCHDOG_SNAP_KEEP=24         # how many newest watchdog snapshots are kept — each one is the same size as the database, so on a large DB lower this (the Full box hit 97 % disk use with four 2.6 GB copies).
#DB_WATCHDOG_PROBE_FAIL_ALERT=3            # after this many runs in a row where the read-only probe failed (but the /tmp copy verified clean) the watchdog says so out loud and names the cause; 0 = never alert
#DB_WATCHDOG_PROBE_ALERT_REPEAT_SEC=86400  # while the probe stays broken, at most one such warning per this many seconds (default 1 day) — not one per cron run
#DB_WATCHDOG_LOCK_ALERT=5        # how many backend "database is locked" errors in the check window make the watchdog say so out loud. The database FILE can read perfectly clean while every request is losing the write lock — that is the "the DB is dead but the watchdog said healthy" shape, and neither the integrity check nor the malformed count sees it. DETECTION ONLY: it never stops the writers, because a restart cannot release a lock another process holds. 0 = never alert.
#DB_WATCHDOG_LOCK_ALERT_REPEAT_SEC=3600  # while contention continues, at most one such warning per this many seconds (not one per cron run). The run is still recorded every time as action=app_contention in .watchdog/events.tsv.
#DB_WATCHDOG_APP_RESTART=false    # APP LIVENESS: every FILE check says healthy but the APP is dead — the backend container reads "unhealthy" (its own health probe stopped answering) or is left in "created" by a recreate that never finished. Detection + a WARN every run are always on (recorded as action=app_down); this switch is what lets the watchdog bring backend+poller back on its own.
#DB_WATCHDOG_APP_RESTART_RUNS=2   # flagged runs in a row before it acts — one is not enough, a backend mid-deploy reads unhealthy too
#DB_WATCHDOG_APP_RESTART_COOLDOWN_SEC=1800   # minimum gap between two watchdog-initiated restarts
#DB_WATCHDOG_APP_HEALTH_WAIT_SEC=600  # how long to wait for the backend to report healthy after a restart
#DB_WATCHDOG_RAMDISK_MODE=skip     # on a ramdisk install: skip = do nothing (default); disk = check the sqlite_data sync copy anyway; live = quick_check the RAM database inside the backend container; both = the two. Auto-recovery is always refused on a ramdisk box.
#DB_WATCHDOG_RAMDISK_RESTART=false # ... except when you set this true: it then RESTARTS backend+poller (the backend's own boot-time validation re-seeds the RAM copy from the disk file). It never promotes a backup over a live in-RAM database.
#DB_WATCHDOG_PROBE_VIA_CONTAINER=false   # set true if the watchdog's read-only check fails with "attempt to write a readonly database" — it then runs the check (and the snapshot) inside the backend container and copies the result out. Never chown or chmod the data dir instead.

# ── Self-protection (optional) ──────────────────────────────────────────────
# Comma-separated IPs that must never be auto-blocked (server NAT IP, mgmt host…).
# PROTECTED_IPS=10.0.0.5,203.0.113.10

# ── Diagnostics bundle (GET /api/v1/system/diagnostics, admin-only) ──────────
# Read-only collector: config facts, docker mount table, storage, backup verdicts, DB facts, masked env.
# The download is a tar.gz; when it would exceed the cap the remaining log entries are dropped and the
# truncation is recorded INSIDE the bundle. diagnostics.json itself is never dropped.
#DIAGNOSTICS_BUNDLE_MAX_MB=25       # cap for GET /system/diagnostics/bundle
#DIAGNOSTICS_LOG_TAIL=500           # per-container `docker logs --tail N` lines in the bundle
#DIAGNOSTICS_INTEGRITY_MAX_MB=500  # backups/DB copies bigger than this are reported as "unchecked" instead of being integrity-scanned inside the request (a 2.6 GB database took 251 s and timed out at the proxy). Use ?deep=true for a full scan.

# ── Poller ─────────────────────────────────────────────────────────────────
# Critical-event record: the poller writes one compact file, <EVENTS_DIR>/poller.tsv, one row per FLAGGED
# event (a failed ARP/neighbour harvest, a degraded STP read, a wireless read that really failed — Lite
# ships no IP scan, so no scan crash appears here). It is a FILE on purpose — it survives a
# container rebuild and keeps working when the database itself is broken. A healthy box writes nothing;
# <EVENTS_DIR>/heartbeat (0 bytes) is what proves the poller is still running:
#   stat -c %y sqlite_data/events/heartbeat
EVENTS_ENABLED=true                 # false = write no record at all
#EVENTS_DIR=/data/events           # = <run-dir>/sqlite_data/events/
#EVENTS_LEVEL=critical             # critical = flagged events only (default). all = one row per event
#EVENTS_LINES=2000                 # rows kept per file before it is trimmed (with a 200-row slack)
# Normal poll interval — every 5 minutes during quiet periods
POLL_INTERVAL_SECONDS=300
# Topology (neighbours / FDB / spanning-tree) poll interval — deliberately slower
# than POLL_INTERVAL_SECONDS to cut write contention on the database.
TOPOLOGY_POLL_INTERVAL_SECONDS=900
# The poller's own API login/logout traffic can match a detection rule and create a
# threat against this server, polluting the Top Attackers list. Off by default.
# HOST_IP_LOG_ENABLED=false
# Max concurrent MikroTik API worker threads (dedicated pool, not the default
# executor). 128 saturated the thread pool on the 109-device KBR fleet; 32 is
# the measured safe default. Override per-fleet if needed.
MIKROTIK_EXECUTOR_WORKERS=32
POLL_INTERVAL_ALERT_SECONDS=60
ALERT_MODE_DURATION_SECONDS=300
BATCH_SIZE=200
LOG_RETENTION_DAYS=90
# Interface traffic samples (bandwidth graphs / Show Traffic). Nothing can query
# further back than 7 days, so 14 is 2x the deepest reachable window. Left unpruned
# this table became 73% of the DB at KBR (1.19 GB of 1.62 GB) and its size sets the
# ramdisk seed time that gates backend startup. 0 disables pruning.
INTERFACE_STATS_RETENTION_DAYS=14
THREAT_RETENTION_DAYS=90
# ── Wireless monitoring tunables ─────────────────────────────────────────────
# Signal thresholds (dBm). A client whose BEST association across all APs is at or
# below weak counts as weak; at or below poor counts as poor. These drive the
# weak/poor counts on the map and in a device's Wireless tab.
WIRELESS_WEAK_SIGNAL_DBM=-75
WIRELESS_POOR_SIGNAL_DBM=-85
# An AP with MORE associated clients than this renders its map client chip amber.
WIRELESS_OVERLOAD_CLIENT_COUNT=30
# How old a client sample may be before it is dropped from the counts. Client rows
# are refreshed once per full poll pass of the fleet, so this must be at least 2x
# that pass (a 10-minute window went intermittently empty on a 110-device fleet).
WIRELESS_FRESHNESS_MINUTES=60
# Per-AP client-count history sampling cadence (minutes); it is what the per-AP
# chart in a device's Stats modal plots. Retention = LOG_RETENTION_DAYS. 0 disables.
WIRELESS_STATS_SAMPLE_INTERVAL_MINUTES=15

# ── Telegram alerts ────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_MIN_SEVERITY=warning               # info | warning | critical
# Multi-recipient (takes precedence when set): comma-separated "chatid:severity".
#TELEGRAM_CHAT_IDS=-1001234567890:warning,-9876543210:critical
# Event-type toggles + noise control (Telegram alerts Phase 1)
TELEGRAM_DEVICE_ALERTS=true                 # device OFFLINE / back-online (debounced)
TELEGRAM_SERVICE_ALERTS=true                # poller start/stop — set false to mute deploy noise
DEVICE_DOWN_ALERT_THRESHOLD=3               # consecutive failed polls before "OFFLINE" fires
POLLER_ERROR_BACKOFF_MAX_SECONDS=900        # how long a device that keeps failing is left alone
                                            # before it is tried again (was every 300 s).
TELEGRAM_SECURITY_ALERTS=true               # account lockout / admin password-2FA-recovery reset / hard-delete / new user
TELEGRAM_JOB_ALERTS=true                    # device reset-restore done or failed (firmware/bulk-CLI are Full-only)
TELEGRAM_DB_ALERTS=true                     # startup auto-heal action taken / scheduled backup failed — db_watchdog.sh reads this SAME key too
#FRONTEND_BASE_URL=http://10.0.0.5          # "View in dashboard →" deep links; empty = none

# Phase 4 (optional polish) — all default OFF, opt-in.
TELEGRAM_DIGEST_INTERVAL_HOURS=0            # e.g. 24 = once a day; threats/auto-blocks/top-attackers/devices-down
TELEGRAM_QUIET_HOURS_ENABLED=false          # suppress THREAT alerts below min severity during the window (HH:MM UTC)
TELEGRAM_QUIET_HOURS_START=22:00
TELEGRAM_QUIET_HOURS_END=07:00
TELEGRAM_QUIET_HOURS_MIN_SEVERITY=critical
TELEGRAM_MAX_ALERTS_PER_MIN=0               # storm coalescing; 0 = no limit
TELEGRAM_INLINE_BUTTONS=false               # Block/Whitelist/View buttons — poller+backend both need this true, same bot/chat

# ── Scheduled email reports ────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=mt-centrallog@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_REPORT_RECIPIENTS=admin@example.com
EMAIL_REPORT_SCHEDULE=daily                 # daily | weekly
EMAIL_REPORT_HOUR=8                         # UTC hour (0–23)
EMAIL_REPORT_DAY=monday

# ── GeoIP (threat map) ─────────────────────────────────────────────────────
GEOIP_ENABLED=true
GEOIP_PROVIDER=ip-api                       # ip-api (free) | ipinfo
GEOIP_CACHE_TTL_HOURS=24

# ── Block resync ───────────────────────────────────────────────────────────
BLOCK_RESYNC_ENABLED=true
BLOCK_RESYNC_INTERVAL_SECONDS=3600
# ── Whitelist DNS ───────────────────────────────────────────────────────────
# How often (minutes) the backend re-resolves hostname-based whitelist entries.
# Set to 0 to disable.
WHITELIST_DNS_CHECK_MINUTES=15

# ── Locate (switch-port lookup) DNS override (optional) ────────────────────────
# Leave empty (default) = FULL AUTO: the app asks each site's own MikroTik as the
# DNS server, which is the correct answer for split-horizon / overlapping-IP sites.
# Set it only to override auto with explicit servers: comma-separated, each a bare
# "ip" (any name) or "site:ip" (that site only), reachable from the backend.
# LOCATE_DNS_SERVERS=BKK:192.168.0.10,KORAT:10.0.0.53
LOCATE_DNS_SERVERS=
# How fresh a DHCP/DNS hostname must be to be shown as a client name in logs and
# locate results (seconds).
CLIENT_NAME_FRESHNESS_SECONDS=600

# ── Jigsaw Trace ───────────────────────────────────────────────────────────
AUTO_TRACE_ENABLED=true
AUTO_TRACE_DURATION=15
AUTO_TRACE_COOLDOWN_SECONDS=300
AUTO_TRACE_DEVICE_TYPES=all                 # router | switch | ap | all (CSV)
AUTO_TRACE_SITES=target                     # target | all | <site1>,<site2>

# ── Network Map — STP designated-bridge displacement ───────────────────────
# On a root/alternate bridge port, spanning-tree names the device across the
# wire (BPDUs are link-local and never forwarded). When true, that evidence may
# TAKE a port from a weaker link (FDB / peeled-STP / MNDP guess) and push the
# old one to Indirect. Never overrides LLDP, SNMP, CapsMan, wireless or manual
# links, never leaves a device with no link at all, and still refuses any bridge
# segment that could have more than two members.
# Leave false on a site whose switch uplinks are wireless hops the map cannot
# resolve yet — there the displaced links, wrong as they are, are the only thing
# holding those groups onto the map. Read as "true" only for: true 1 yes on.
STP_DESIGNATED_DISPLACE=false

# Hold a link recently proven by a spanning-tree (BPDU) claim on the map for up
# to this many seconds when the claim briefly lapses — stops stable cables from
# flickering with radio conditions on switch<->AP rings. 0 disables.
# (Whether a held link may take an OCCUPIED port is STP_HOLD_DISPLACE below.)
STP_DESIGNATED_HOLD_SECONDS=600
# Where the hold cache persists across backend restarts (default shown).
#STP_HOLD_CACHE_FILE=/data/.stp_hold_cache.json

# May a held link take a port something else already occupies? (2026-08-20)
# false (default) = no; both ports must be free, so a held link never displaces
# anything.
#
# Turn it on if a switch reached over a RADIO shows the wrong uplink for a poll
# or two and then corrects itself. That port hears the whole site through the
# radio, so it collects a large pile of weak candidates — one of them grabs the
# port whenever the real spanning-tree claim lapses for a cycle, and the hold
# that exists to prevent exactly that cannot fire because the port is busy.
#
# With true the hold pushes aside only a WEAK occupant, never a link proven by
# LLDP/SNMP/CapsMAN/spanning-tree, never one that would leave another device with
# no links at all, and never another held link.
#
# ⚠ Ships OFF: it can move a lot of links at once, on evidence that has briefly
# lapsed. Flip it, restart the backend (no rebuild needed), and watch the map
# before keeping it. Read as "true" only for: true 1 yes on.
STP_HOLD_DISPLACE=false

# ── Backup fetch push (optional) ────────────────────────────────────────────
# Base URL this backend is reachable at FROM MikroTik (last-resort backup upload).
# Example: http://192.168.1.100:80
BACKEND_FETCH_URL=

# ── MNDP broadcast network (ipvlan L2) — MUST match your LAN ─────────────────
# Find your LAN interface with `ip link show`; pick an IP range OUTSIDE the DHCP pool.
# install.sh replaces this with the interface on your default route. If detection fails, set it
# to the NIC your MikroTik devices reach you on (`ip link show`) — eth0 on a wired host,
# wlan0 / wlo1 on Wi-Fi. The compose fallback is eth0 when the key is absent.
MNDP_PARENT_IFACE=wlo1
MNDP_SUBNET=192.168.10.0/24
MNDP_GATEWAY=192.168.10.254
MNDP_IP_RANGE=192.168.10.192/28

# ── MNDP relay ─────────────────────────────────────────────────────────────
MNDP_RELAY_URL=http://host-gateway:5679

# ── CORS origins (comma-separated) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80

# ── Internal API key (poller → backend) ────────────────────────────────────
BACKEND_API_KEY=change_me_internal_api_key
# Where the POLLER reaches the backend API (the internal trace call uses it). Only
# change it if the backend service name or port differs from the compose default.
#BACKEND_URL=http://backend:8000

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                             # json | console

# Wake-up ping over the RouterOS API (default false). Shares the live poll socket;
# leaving it off avoids the crossed-reply bug that empties a device's health
# snapshot and nulls its STP port numbers. The old call form never worked.
PING_WAKE_ENABLED=false

# ── RTT Deep probe (the "RTT Deep" button on a node card) ───────────────────
# ANALYSIS ONLY — nothing in the topology algorithm reads the result, so these
# knobs cannot change the map. They only shape the measurement.
#
# 30 packets of 1400 bytes is the MEASURED recipe, not a guess: with 10 packets
# of 64 bytes a cabled neighbour and one a single wireless hop away BOTH report
# 0.00 min/avg/max and cannot be told apart. A large frame costs a radio real
# airtime and costs a cable nothing, which is what separates them.
RTT_PROBE_COUNT=30
RTT_PROBE_SIZE=1400
# Tightened from the RouterOS default of 1s so a probe takes seconds, not
# minutes. More packets per second is MORE airtime pressure, not less, so it
# should preserve the discrimination — but the original measurement was taken
# at 1s, so re-validate against a known cable before trusting a changed value.
RTT_PROBE_INTERVAL=100ms
# Ceiling on targets per run. A probe blocks that ONE device's poll loop for
# roughly count x interval x targets, and a 1400-byte burst is real airtime on
# a hub serving live clients.
RTT_PROBE_MAX_TARGETS=24

# Demote physically-impossible wired<->wireless "direct" links (default true).
# Set false to rule this pass out when investigating a missing link. Flip it here and
# run `docker compose up -d` (no image rebuild). Siblings: WIRELESS_REG_EDGES, WIRELESS_FLOOD_DEMOTE.
STP_WIRELESS_FLOOD_DEMOTE=true

# Require a SNMP splice link's port to be one the switch's OWN bridge-FDB table
# lists (default true). RouterOS answers LLDP on every VLAN interface, so a
# RouterOS switch discovered only via SNMP (not added to the Devices page) can
# show direct links on bridge1-vlanX names, which are not physical ports.
# Set false to restore the old behaviour — restart the backend only, no rebuild.
# Inert on Lite: Lite never runs the SNMP topology block, so it draws no splice
# links at all; the key is carried for source parity only.
SNMP_SPLICE_FDB_CORROBORATE=true

# Draw PtMP / mesh / WDS links from each AP's own registration table (default true).
# Set false to rule that whole controller-less-wireless layer out when investigating
# a phantom or missing wireless link — flip it here and run `docker compose up -d`
# (no image rebuild).
WIRELESS_REG_EDGES=true
# Demote the flooded links those registration passes can create (default true).
# This one is the narrower switch: it disables only the demotion, not the links.
WIRELESS_FLOOD_DEMOTE=true

# How many times in a row a switch must give the same bad spanning-tree answer
# before it is believed (default 5). Some switches occasionally reply with a short,
# wrong list of ports; saving that over the good one costs the switch its uplink,
# and its neighbours lose their port names too. One good reply resets the count, so
# a switch that flips between good and bad answers keeps its links, while a real
# change to its ports is still picked up after this many polls.
# Set 1 to accept a single bad answer (the older behaviour).
STP_DEGRADED_ACCEPT_AFTER=5

# Find cables reached through a WIRELESS hop (the "partition" test, default true).
# A real point-to-point cable splits the network in two: each end's port hears
# everything on the far side and nothing on its own. A pairing that is really
# several hops apart cannot do that. It is the only thing that works for a switch
# sitting behind a radio, whose port hears the whole site.
#
# ⚠ It shipped on, then wrongly hid the real uplinks hanging off a busy CORE port
# (a port spanning-tree shares between many switches at once), and had to be
# turned off within a day. A guard added 2026-08-20 stops that — a port with two
# or more spanning-tree links on it is never treated as false — and it was turned
# back on.
#
# Set false to rule this pass out when investigating a WRONG or MISSING link —
# no rebuild, restart the backend only.
# ⚠ A value here BEATS the built-in default, so leaving the line out means you get
# whatever the shipped default is. Read as "true" only for: true 1 yes on.
TOPOLOGY_PARTITION_DEMOTE=true

# --- Stop a device that is GONE from asserting stale links (ROADMAP 6.15) ---
# A device that is still ENABLED but unreachable is never polled, so its
# neighbour / FDB / STP rows are frozen at the last snapshot before it vanished
# and can NEVER age out (expiry needs a poll to OBSERVE a row missing). It then
# asserts links forever. Measured at KBR: a device gone 41.5 h held a switch's
# ROOT port, which demoted that switch's REAL uplink to Indirect.
# After this many hours without a successful poll, the device's OWN evidence is
# ignored. Another device's FRESH sighting of it still draws (that means it is
# still plugged in). Self-healing: it resumes claiming the moment it polls again.
# 0 = disable this behaviour entirely (kill-switch).
TOPOLOGY_STALE_CLAIM_TTL_HOURS=6

# --- Mute unreachable devices sooner (default OFF) ---
# A device that cannot be polled keeps its old map claims, and an old claim can
# hide a real link. Minutes without a successful poll before its own claims are
# ignored. 0 = OFF. If you enable it use 30 or more — smaller values can mute
# healthy devices while the poller is still working through the fleet.
# Set 0 + `docker compose restart backend` to rule it out without a rebuild.
TOPOLOGY_UNREACHABLE_MUTE_MINUTES=0

# --- Root-port upstream from the BPDU (2026-08-22) ---
# A root port's designated_bridge_mac NAMES the upstream bridge. true = use it when
# it resolves to a single managed device that is also heard on that port; false =
# fall back to the old "designated port with the fewest remaining neighbours" guess.
# The BPDU is authoritative ONLY as far as the STP read is trustworthy: on a site
# where roles flap or are misreported, following it can make an edge flip MORE.
# Set false + `docker compose restart backend` (no rebuild) to rule this pass out.
TOPOLOGY_ROOT_PORT_BPDU=true
# --- FDB mutual evidence for managed-managed links (Pass 6.10, 2026-09-13) ---
# Set false + `docker compose restart backend` (no rebuild) to disable.
FDB_MUTUAL_LINKS=true

# ── Topology snapshot timeline ─────────────────────────────────────────────
# Capture tick in seconds: the loop wakes this often and writes a snapshot only when the
# graph's volatile-stripped hash changes, so steady-state polling costs nothing and a short
# tick is cheap. Code default is 15; this template ships 900 (a capture pass every 15 min).
# 0 disables capture entirely.
TOPOLOGY_SNAPSHOT_INTERVAL_S=900
# Retention: snapshots older than this many days are pruned. Code default 90; this
# template ships 3 to keep the timeline light.
TOPOLOGY_SNAPSHOT_RETENTION_DAYS=3
# Network History replay: seconds a device's newest health sample may be older
# than the frame time before it is marked offline. The health poller samples
# every ~16 min; 900 s caused false offline blips. Default 1800 (30 min).
TOPOLOGY_HISTORY_OFFLINE_STALE_S=1800




# ── Native firmware update check ──
# Each device asks MikroTik for the newest RouterOS on its own channel,
# once a day. The Firmware page shows that answer (source "native") when it
# is fresh. OFF by default. Lite has no Firmware page; the setting is kept
# identical so a DB can move between editions.
FIRMWARE_NATIVE_UPDATE_CHECK=false
FIRMWARE_UPDATE_CHECK_INTERVAL_HOURS=24

# Firmware stale-job watchdog: a stuck upgrade job is finalized from the
# device's own RouterOS version and the device is released from "busy".
# Lite has no Firmware page; the setting is kept identical so a DB can move
# between editions. Default 60 minutes.
FIRMWARE_STALE_JOB_MINUTES=60
